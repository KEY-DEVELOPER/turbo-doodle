# Copy to .env (git-ignored) and adjust. No real secrets in this file - ever.

# --- docker-compose (dev-only credentials) ---
POSTGRES_USER=edgeledger
POSTGRES_PASSWORD=edgeledger
POSTGRES_DB=edgeledger
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=edgeledger
MINIO_ROOT_PASSWORD=edgeledger-dev-only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- backend (read by app/core/config.py, prefix EDGELEDGER_) ---
EDGELEDGER_ENVIRONMENT=dev
EDGELEDGER_LOG_LEVEL=INFO
EDGELEDGER_DATABASE_URL=postgresql+psycopg://edgeledger:edgeledger@localhost:5432/edgeledger
EDGELEDGER_REDIS_URL=redis://localhost:6379/0
EDGELEDGER_S3_ENDPOINT_URL=http://localhost:9000
EDGELEDGER_S3_BUCKET=edgeledger-dev
EDGELEDGER_S3_ACCESS_KEY=edgeledger
EDGELEDGER_S3_SECRET_KEY=edgeledger-dev-only

# Tests create and drop a throwaway database per run through this server/user.
EDGELEDGER_TEST_DATABASE_URL=postgresql+psycopg://edgeledger:edgeledger@localhost:5432/postgres

# Licensed data providers (PRD 4.8). Leave empty until keys exist; backend-only, never sent
# to the browser, never logged, never committed.
EDGELEDGER_SPORTMONKS_API_KEY=
EDGELEDGER_THE_ODDS_API_KEY=
EDGELEDGER_FOOTBALL_DATA_API_KEY=

# --- frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
